    <string name="info_title">Welcome to AVSPlayer!</string>
    <string name="info_text">AVSPlayer plays local video and audio files in both foreground and background.</string>
    <string name="info_text2">Tap the app icon, pick one or more files in the Android file picker, and playback starts.</string>
    <string name="info_text3">Tap the screen once for the player controls; the playlist button opens a sheet with the playlist, the file picker, and an exit button.</string>
    <string name="info_text4">AVSPlayer has no ads, analytics, accounts, or Internet permission and sends no personal data to the developer.</string>
